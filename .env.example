# Optional: the model fallback for voice commands (api/voice.ts).
#
# Leave every line unset and Plexus still works — voice falls back to the
# offline grammar, and /api/voice answers 501 so the client stops asking.
#
# Copy to .env.local (gitignored) for `vercel dev`, or set these as
# Environment Variables in the Vercel dashboard for a deploy.
#
# Never prefix these with VITE_ — that would inline the key into the bundle.

# TypeSafe API key. Get one at https://typesafe.ai
VOICE_API_KEY=
# The API origin. Only worth changing to point at a different environment.
VOICE_API_BASE=https://api.typesafe.ai
# Jev is TypeSafe's System One model — it answers typed questions rather than
# generating text. Pin a version here if you would rather not track latest.
VOICE_MODEL=jev-latest
